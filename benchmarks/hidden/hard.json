{
  "level": "hard",
  "description": "Markdown notes: editor renders markdown, notes persist across reload, search filters.",
  "checks": [
    {"name": "note-list", "type": "exists", "selector": "#note-list"},
    {"name": "new-note-button", "type": "exists", "selector": "#new-note"},
    {"name": "editor", "type": "exists", "selector": "#editor"},
    {"name": "preview", "type": "exists", "selector": "#preview"},
    {"name": "search-box", "type": "exists", "selector": "#search"},
    {"name": "renders-heading", "type": "exists", "selector": "#preview h1",
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "# Title One"}}, {"wait_ms": 400}]},
    {"name": "renders-bold", "type": "exists", "selector": "#preview strong, #preview b",
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "some **bold** text"}}, {"wait_ms": 400}]},
    {"name": "renders-italic", "type": "exists", "selector": "#preview em, #preview i",
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "some *italic* text"}}, {"wait_ms": 400}]},
    {"name": "renders-link", "type": "exists", "selector": "#preview a[href]",
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "a [link](https://example.com) here"}}, {"wait_ms": 400}]},
    {"name": "renders-code", "type": "exists", "selector": "#preview code",
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "use `code` inline"}}, {"wait_ms": 400}]},
    {"name": "renders-list", "type": "exists", "selector": "#preview ul li",
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "- one\n- two"}}, {"wait_ms": 400}]},
    {"name": "persists-across-reload", "type": "text_present", "text": "Persistent Note",
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "# Persistent Note\n\nbody text"}},
               {"wait_ms": 600}, {"reload": true}, {"wait_ms": 600}]},
    {"name": "search-filters", "type": "count", "selector": "#note-list > *", "expect": 1,
     "steps": [{"click": "#new-note"}, {"fill": {"#editor": "# Alpha"}}, {"wait_ms": 400},
               {"click": "#new-note"}, {"fill": {"#editor": "# Beta"}}, {"wait_ms": 400},
               {"fill": {"#search": "Alpha"}}, {"wait_ms": 500}]},
    {"name": "no-console-errors", "type": "no_console_errors"}
  ]
}
