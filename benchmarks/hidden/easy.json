{
  "level": "easy",
  "description": "To-do list: adding shows the task, it survives a reload, delete removes it, and empty input is harmless.",
  "checks": [
    {"name": "add-task-appears", "type": "text_present", "text": "Buy milk",
     "steps": [{"fill": {"#new-todo": "Buy milk"}}, {"click": "#add-todo"}, {"wait_ms": 400}]},

    {"name": "task-survives-reload", "type": "text_present", "text": "Buy milk",
     "steps": [{"fill": {"#new-todo": "Buy milk"}}, {"click": "#add-todo"}, {"wait_ms": 600},
               {"reload": true}, {"wait_ms": 600}]},

    {"name": "delete-removes-task", "type": "count", "selector": "#todo-list li", "expect": 0,
     "steps": [{"fill": {"#new-todo": "Buy milk"}}, {"click": "#add-todo"}, {"wait_ms": 400},
               {"click": "#todo-list li .delete"}, {"wait_ms": 400}]},

    {"name": "empty-input-is-harmless", "type": "text_present", "text": "Real task",
     "steps": [{"click": "#add-todo"}, {"wait_ms": 200}, {"fill": {"#new-todo": "   "}},
               {"click": "#add-todo"}, {"wait_ms": 200},
               {"fill": {"#new-todo": "Real task"}}, {"click": "#add-todo"}, {"wait_ms": 400}]}
  ]
}
